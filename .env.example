# =============================================================================
# DevOps AI Auditor - Environment Configuration Example
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit a populated `.env` file. No real credentials belong in git.
# =============================================================================

# ---- General ----
# Environment: development | staging | production
ENVIRONMENT=development
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Emit logs as JSON (recommended in production) or human-readable console format.
LOG_JSON=false

# ---- Backend API ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins for the frontend.
# Do NOT use '*' in production - it is rejected at startup. Wildcard also
# disables credentialed CORS responses.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Security / hardening ----
# When set, every /api/v1 request (except health probes) must send this key in
# the `X-API-Key` header. Leave blank for an open API in local development.
# In production, leaving this blank logs a warning.
API_KEY=
# In-process request rate limiting (per client IP). Uploads get a stricter budget.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=30
# Only enable when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_FORWARDED_FOR=false

# ---- Scan execution ----
# Run scans on the Celery worker (off the request path). Requires the worker and
# a Redis broker, and WORKSPACE_ROOT to be a filesystem shared by the API and
# worker (docker-compose configures this automatically). When false, scans run
# synchronously in the API process.
SCAN_ASYNC=true

# ---- Git repository ingestion ----
# Allow ingesting repositories directly from a URL via POST /api/v1/scans/git.
GIT_INGESTION_ENABLED=true
# Maximum seconds a clone may run before it is aborted.
GIT_CLONE_TIMEOUT=300
# Optional comma-separated allowlist of clone hosts (e.g. github.com,gitlab.com).
# Leave blank to accept any http(s) host.
GIT_ALLOWED_HOSTS=
# Permit cloning from local paths / file:// URLs. Keep false outside of tests
# (SSRF and local-file hygiene).
GIT_ALLOW_LOCAL_CLONES=false

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=auditor
POSTGRES_PASSWORD=change-me-in-your-env
POSTGRES_DB=auditor

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Optional Redis password (leave blank for local development without auth).
REDIS_PASSWORD=

# ---- Frontend ----
# Base URL the browser uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000

# ---- AI reasoning + AI review scan (LLM) ----
# Provider: none (deterministic, default), openai, anthropic, or gemini.
LLM_PROVIDER=gemini
# For Gemini use a gemini-* model, e.g. gemini-1.5-flash or gemini-2.0-flash.
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your-gemini-api-key
# Optional: override the API base URL (e.g. a local OpenAI-compatible server).
LLM_BASE_URL=

# Enable the complementary AI review pass that finds issues the rules may miss.
# Requires an LLM provider above. Findings are marked scanner="ai-review",
# confidence-capped and never auto-remediated. NOTE: this sends source files to
# the configured model - use a local/self-hosted model to avoid data egress.
AI_SCAN_ENABLED=true
AI_SCAN_MAX_FILES=25
AI_SCAN_MAX_FILE_BYTES=8000

# Use the LLM inside the /report reasoning graph. Keep false: the report is the
# authoritative, deterministic view and must render instantly. Enabling it fires
# one LLM call per finding on every report load (slow, and can hit rate limits).
# On-demand AI lives in the AI-assist endpoints (summary, prioritize, chat).
AI_REPORT_ENABLED=false

# =============================================================================
# Phase 2 - Continuous DevSecOps platform (SCM integrations, PR scanning,
# policies, webhooks, notifications). All optional: unset values simply disable
# the related feature.
# =============================================================================

# ---- Secret storage (REQUIRED to enable SCM integrations) ----
# Fernet key used to encrypt SCM access tokens and webhook secrets at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, integrations are DISABLED (the API never stores tokens in plaintext).
INTEGRATION_ENCRYPTION_KEY=

# ---- Public ingress ----
# Public base URL of this auditor (used for PR "view scan" links and the
# target_url of commit status checks), e.g. https://auditor.example.com
PUBLIC_BASE_URL=

# ---- GitHub integration ----
# API base. Use https://api.github.com for github.com, or
# https://<host>/api/v3 for GitHub Enterprise Server.
GITHUB_API_URL=https://api.github.com
# Shared webhook secret used to verify X-Hub-Signature-256 on inbound webhooks.
# A per-integration secret (set when registering a webhook) takes precedence.
GITHUB_WEBHOOK_SECRET=

# ---- GitLab integration ----
GITLAB_API_URL=https://gitlab.com/api/v4
# Secret compared (constant-time) against the X-Gitlab-Token webhook header.
GITLAB_WEBHOOK_SECRET=

# ---- Webhooks ----
# Reject inbound webhook payloads larger than this many bytes.
WEBHOOK_MAX_BODY_BYTES=1000000

# ---- Notifications (optional) ----
# SMTP is only needed for the email notification channel type.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=devops-auditor@localhost
# STARTTLS on the SMTP connection (recommended).
SMTP_USE_TLS=true
# Allow notification webhooks to target private/loopback hosts. Keep false in
# production (SSRF protection); the test suite enables it.
NOTIFICATIONS_ALLOW_PRIVATE_HOSTS=false
