# =============================================================================
# DevOps AI Auditor - Environment Configuration Example
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit a populated `.env` file. No real credentials belong in git.
# =============================================================================

# ---- General ----
# Environment: development | staging | production
ENVIRONMENT=development
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Emit logs as JSON (recommended in production) or human-readable console format.
LOG_JSON=false

# ---- Backend API ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins for the frontend.
# Do NOT use '*' in production - it is rejected at startup. Wildcard also
# disables credentialed CORS responses.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Security / hardening ----
# When set, every /api/v1 request (except health probes) must send this key in
# the `X-API-Key` header. Leave blank for an open API in local development.
# In production, leaving this blank logs a warning.
API_KEY=
# In-process request rate limiting (per client IP). Uploads get a stricter budget.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=30
# Only enable when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_FORWARDED_FOR=false

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=auditor
POSTGRES_PASSWORD=change-me-in-your-env
POSTGRES_DB=auditor

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Optional Redis password (leave blank for local development without auth).
REDIS_PASSWORD=

# ---- Frontend ----
# Base URL the browser uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000
